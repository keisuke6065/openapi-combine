{
  "name": "openapi-combine",
  "version": "0.3.1",
  "author": "keisuke.nakamura @keisuke6065",
  "bin": {
    "openapi-combine": "./bin/run"
  },
  "bugs": "https://github.com/keisuke6065/openapi-combine/issues",
  "dependencies": {
    "@oclif/core": "^5.0.0",
    "@oclif/plugin-help": "^7.0.0",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.set": "^4.3.9",
    "@types/node": "^24.13.3",
    "js-yaml": "^5.4.1",
    "json-refs": "^3.0.15",
    "lodash.get": "^4.4.2",
    "lodash.set": "^4.3.2",
    "mkdirp": "^3.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^17.0.4",
    "chai": "^4.5.0",
    "eslint": "^9.39.5",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0",
    "oclif": "^5.0.0",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/keisuke6065/openapi-combine",
  "keywords": [
    "oclif",
    "openapi",
    "openapi3",
    "swagger",
    "combine",
    "merge"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "openapi-combine",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "packageManager": "pnpm@10.34.5",
  "repository": "keisuke6065/openapi-combine",
  "scripts": {
    "start": "./bin/run",
    "build": "tsc -b",
    "lint": "eslint 'src/**/*.ts'",
    "postpack": "rm -f oclif.manifest.json",
    "posttest": "eslint .",
    "prepack": "rm -rf lib && tsc -b && oclif manifest && oclif readme",
    "test": "nyc --extension .ts mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "readme": "oclif readme"
  },
  "types": "lib/index.d.ts"
}
